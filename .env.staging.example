# Copy to .env.staging. This file contains placeholders, never usable credentials.
HS_ORIGIN=https://holy-sheet.staging.example.invalid
HS_RICH_EDITOR_ENABLED=0
HS_IDENTITY_ISSUER=https://suite-identity.example.invalid
HS_IDENTITY_JWKS_URL=https://suite-identity.example.invalid/.well-known/jwks.json
HS_IDENTITY_AUDIENCE=holy-sheet
# Generate distinct values locally and keep .env.staging out of Git.
POSTGRES_PASSWORD=
# Qualified private S3-compatible storage; public bucket access must be disabled.
S3_ENDPOINT=https://private-object-store.example.invalid
S3_REGION=us-east-1
S3_BUCKET=holy-sheet-staging
HS_SCANNER_PLATFORM=linux/amd64
HS_STORAGE_ACCESS_KEY=holy-sheet-staging
HS_STORAGE_SECRET_KEY=
# Exactly 32 random bytes encoded as Base64. No plaintext device recovery keys.
HS_RECOVERY_MASTER_KEY=
# Separate operator credential, at least 32 characters; never exposed to browsers.
HS_MAINTENANCE_TOKEN=
# Exact trusted suite identity for the initial staging owner; not an email fallback.
HS_BOOTSTRAP_USER_ID=
HS_BOOTSTRAP_USER_NAME=Staging owner
